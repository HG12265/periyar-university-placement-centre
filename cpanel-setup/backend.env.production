# ==============================================================================
# PERIYAR UNIVERSITY PLACEMENT PORTAL - PRODUCTION ENVIRONMENT VARIABLES (cPanel)
# ==============================================================================
# Save this file as ".env" inside your backend directory on cPanel (e.g. /home/username/backend/.env)

# Environment Mode
NODE_ENV=production

# Server Port (Passenger on cPanel assigns its own port or socket, 5000 is default fallback)
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (MySQL / MariaDB on cPanel)
# Format: mysql://DB_USERNAME:DB_PASSWORD@localhost:3306/DB_NAME
# Replace "cpaneluser_dbuser", "YOUR_STRONG_PASSWORD", and "cpaneluser_placement"
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://cpaneluser_dbuser:YOUR_STRONG_PASSWORD@localhost:3306/cpaneluser_placement"

# ------------------------------------------------------------------------------
# FRONTEND DOMAIN (CORS Security)
# The full URL of your frontend website without trailing slash.
# Examples:
#   FRONTEND_URL=https://placement.periyaruniversity.ac.in
#   FRONTEND_URL=https://yourdomain.com
# ------------------------------------------------------------------------------
FRONTEND_URL=https://placement.periyaruniversity.ac.in

# Cookie Security (Set to "true" for HTTPS production domains)
COOKIE_SECURE=true

# Session Expiry (in hours, e.g. 24)
SESSION_HOURS=24

# Directory for file uploads (resumes, logos, photos, certs)
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# EMAIL SMTP CONFIGURATION (For Student Invitations & Password Reset Links)
# You can use Periyar University Webmail SMTP or Gmail App Password
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=gowtham114411@gmail.com
SMTP_PASSWORD=olmdbdkovjulozke
SMTP_FROM="Periyar University Placement Portal <gowtham114411@gmail.com>"

