# ==============================================================================
# PERIYAR UNIVERSITY PLACEMENT PORTAL - FRONTEND BUILD ENVIRONMENT VARIABLES
# ==============================================================================
# Save this file as ".env.production" inside your frontend folder before building:
#   npm run build

# ------------------------------------------------------------------------------
# OPTION 1: If Backend is running on a Subdomain (Recommended for cPanel)
# Example: https://api.placement.periyaruniversity.ac.in/api
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=https://api.placement.periyaruniversity.ac.in/api

# ------------------------------------------------------------------------------
# OPTION 2: If Backend and Frontend share the SAME domain using Apache Reverse Proxy
# Example: If frontend is at https://yourdomain.com and API is at https://yourdomain.com/api
# Uncomment the line below if using same-domain setup:
# VITE_API_BASE_URL=/api

